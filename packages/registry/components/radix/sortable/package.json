{
  "name": "@reui-unbound/components-radix-sortable",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "cn": "^0.5.2",
    "radix-ui": "^1.8.1",
    "sonner": "^2.0.8"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --format esm --splitting --packages external",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
