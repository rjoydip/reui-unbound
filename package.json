{
  "name": "@reui-unbound/registry",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bunx --bun tsc -b && bun --bun vite build",
    "lint": "bunx --bun oxlint",
    "preview": "bun --bun vite preview",
    "typecheck": "bunx --bun tsc -b",
    "test": "bun test src",
    "test:e2e": "bunx playwright test",
    "registry:generate": "bun scripts/generate-registry.mjs",
    "registry:build": "bun run registry:generate && bun scripts/clean-registry.mjs && bunx --bun shadcn build && bun scripts/verify-registry.mjs",
    "prebuild": "bun run registry:build",
    "predev": "bun run registry:build",
    "registry:verify": "bun scripts/verify-registry.mjs",
    "pretypecheck": "bun run registry:generate",
    "packages:build": "bun run registry:build && bun scripts/build-npm-packages.mjs",
    "packages:publish": "bun scripts/publish-npm-packages.mjs",
    "packages:publish:dry": "bun scripts/publish-npm-packages.mjs --dry-run",
    "docs:generate": "bun run registry:generate && bun scripts/generate-docs.mjs && bun scripts/generate-tracker.mjs",
    "blocks:sync": "bun scripts/sync-application-blocks.mjs",
    "tracker:generate": "bun scripts/generate-tracker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@headless-tree/core": "^1.8.0",
    "@headless-tree/react": "^1.8.0",
    "@hookform/resolvers": "^7.0.8",
    "@remixicon/react": "^4.9.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "kirari": "^1.2.0",
    "little-date": "^1.2.1",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.18",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "packageManager": "bun@1.4.5"
}
